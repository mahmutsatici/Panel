{
  "name": "masaustu-panel",
  "productName": "Panel",
  "version": "2.0.2",
  "description": "Saat, hava durumu, yapılacaklar, Markdown notlar ve sesli asistan için kişisel masaüstü paneli",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "npm run build && electron .",
    "build": "node scripts/build.js",
    "icon": "node scripts/make-icon.js",
    "dist": "npm run build && electron-builder --win nsis",
    "backup": "node scripts/backup.js",
    "predist": "node scripts/backup.js --label=dist",
    "notes": "node scripts/release-notes.js",
    "postdist": "node scripts/release-notes.js",
    "test:rules": "node scripts/test-rules.js"
  },
  "build": {
    "appId": "local.masaustu.panel",
    "productName": "Panel",
    "directories": {
      "output": "dist/v${version}"
    },
    "files": [
      "main.js",
      "preload.js",
      "scripts/ytm.ps1",
      "src/**",
      "node_modules/marked/lib/**",
      "node_modules/dompurify/dist/**",
      "node_modules/@fontsource-variable/inter/**"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    },
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "icon.png",
          "icon.ico"
        ]
      }
    ]
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "@bybas/weather-icons": "^2.0.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@toast-ui/editor": "^3.2.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "firebase": "^13.1.0"
  },
  "overrides": {
    "dompurify": "$dompurify"
  }
}
