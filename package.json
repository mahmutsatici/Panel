{
  "name": "masaustu-panel",
  "productName": "Panel",
  "version": "1.0.0",
  "description": "Saat, hava durumu, yapılacaklar ve Markdown notlar için kişisel masaüstü paneli",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "npm run build && electron .",
    "build": "node scripts/build.js",
    "icon": "node scripts/make-icon.js",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "local.masaustu.panel",
    "productName": "Panel",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "node_modules/marked/lib/**",
      "node_modules/dompurify/dist/**",
      "node_modules/@fontsource-variable/inter/**"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    },
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "icon.png",
          "icon.ico"
        ]
      }
    ]
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "@bybas/weather-icons": "^2.0.0",
    "@toast-ui/editor": "^3.2.2"
  },
  "overrides": {
    "dompurify": "$dompurify"
  }
}
