rules_version = '2';

// Panel — ortak kategoriler için güvenlik kuralları.
// Bu kurallar sunucu tarafındaki TEK savunmadır: istemci kodu ne yaparsa yapsın buradaki izinler aşılamaz.
// Her değişiklikten sonra: npm run test:rules (Firebase emülatörü + firebase/tests/rules.test.js)
//
// Modelin özeti:
//   allowed/{uid}              izin listesi — yalnızca proje sahibi konsoldan yazar. Listede olmayan hiçbir şey okuyamaz/yazamaz.
//   admins/{uid}               yönetici listesi — yalnızca konsoldan yazılır.
//   istekler/{uid}             izin listesinde olmayan hesabın "beni ekle" isteği (yönetici onaylar → allowed/{uid})
//   kullanim/{uid}             her istemcinin günlük tahmini okuma/yazma sayısı (yönetici paneli için)
//   ayarlar/spark              Spark (Gemini) model ayarları — herkes okur, yalnızca yönetici yazar
//   categories/{cid}           kategori: ad, sahip (e-posta), uyeler (e-posta listesi), simge, silindi. Tek üyeli kategori = kişisel kategori.
//   users/{uid}/tercihler/kategori   kişiye özel kategori sırası
//   users/{uid}/istatistik/ozet      kişiye özel tamamlama sayaçları (gün/süre/kategori)
//   categories/{cid}/tasks/{tid}  görevler
//
// İzin listesi e-posta değil UID ile tutulur: biri izin listesindeki bir kişinin e-postasıyla önceden hesap açsa bile
// UID'si farklı olacağından hiçbir erişimi olmaz.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function allowedDoc() { return /databases/$(database)/documents/allowed/$(request.auth.uid); }
    function activeUser() { return signedIn() && exists(allowedDoc()) && get(allowedDoc()).data.aktif == true; }
    function me() { return request.auth.token.email.lower(); }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // Hesap kayıtları: yönetici dışında kimse listeleyemez (e-posta taraması yapılamasın); herkes yalnızca kendi belgesini okur.
    // İzin listesini yönetici (admins/{uid} belgesi olan hesap) yönetir; yönetici listesi yalnızca konsoldan yazılır.
    match /allowed/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['eposta', 'ad', 'aktif'])
        && request.resource.data.eposta is string && request.resource.data.eposta.size() <= 120
        && request.resource.data.ad is string && request.resource.data.ad.size() <= 60
        && request.resource.data.aktif is bool;
      allow delete: if isAdmin();
    }
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // "Beni ekle" isteği: giriş yapmış ama izin listesinde olmayan hesap kendi belgesini yazar; yönetici listeler, onaylar, siler.
    match /istekler/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list, delete: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['eposta', 'zaman'])
        && request.resource.data.eposta == me()
        && request.resource.data.zaman == request.time;
    }

    // Ortak uygulama ayarları: aktif hesaplar okur; yalnızca yönetici yazar. Şimdilik tek belge: ayarlar/spark (Gemini model adları).
    match /ayarlar/{doc} {
      allow get: if activeUser();
      allow list, delete: if false;
      allow create, update: if isAdmin() && doc == 'spark'
        && request.resource.data.keys().hasOnly(['geminiModel', 'yedekModeller', 'sesModelleri', 'guncelleme'])
        && request.resource.data.geminiModel is string && request.resource.data.geminiModel.size() <= 100
        && request.resource.data.yedekModeller is list && request.resource.data.yedekModeller.size() <= 10
        && request.resource.data.sesModelleri is list && request.resource.data.sesModelleri.size() <= 10
        && request.resource.data.guncelleme == request.time;
    }

    // Kişiye özel kategori sırası: yalnızca kendi belgesi (users/{uid}/tercihler/kategori)
    match /users/{uid}/tercihler/{doc} {
      allow get: if activeUser() && request.auth.uid == uid;
      allow list, delete: if false;
      allow create, update: if activeUser() && request.auth.uid == uid && doc == 'kategori'
        && request.resource.data.keys().hasOnly(['sira', 'guncelleme'])
        && request.resource.data.sira is list && request.resource.data.sira.size() <= 300
        && request.resource.data.guncelleme == request.time;
    }
    // Kişiye özel istatistik sayaçları (tek belge: günlük/süre/kategori sayıları; artırma işlemleriyle güncellenir)
    match /users/{uid}/istatistik/{doc} {
      allow get: if activeUser() && request.auth.uid == uid;
      allow list, delete: if false;
      allow create, update: if activeUser() && request.auth.uid == uid && doc == 'ozet'
        && request.resource.data.keys().hasOnly(['g', 's', 'sn', 'k'])
        && request.resource.data.get('g', {}) is map && request.resource.data.get('g', {}).size() <= 5000
        && request.resource.data.get('s', {}) is map && request.resource.data.get('s', {}).size() <= 5000
        && request.resource.data.get('sn', {}) is map && request.resource.data.get('sn', {}).size() <= 5000
        && request.resource.data.get('k', {}) is map && request.resource.data.get('k', {}).size() <= 500;
    }

    // Kullanım sayacı: her aktif hesap yalnızca kendi belgesine yazar; yönetici hepsini okur.
    match /kullanim/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list, delete: if isAdmin();
      allow create, update: if activeUser() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['eposta', 'gun', 'okuma', 'yazma', 'guncelleme'])
        && request.resource.data.eposta == me()
        && request.resource.data.gun is string && request.resource.data.gun.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.okuma is int && request.resource.data.okuma >= 0
        && request.resource.data.yazma is int && request.resource.data.yazma >= 0
        && request.resource.data.guncelleme == request.time;
    }

    match /categories/{cid} {
      function isOwner() { return resource.data.sahip == me(); }
      function isMember() { return me() in resource.data.uyeler; }
      function validCat(d) {
        return d.keys().hasOnly(['ad', 'sahip', 'uyeler', 'uyeAdlari', 'olusturma', 'simge', 'silindi', 'silinmeZamani'])
          && (d.get('simge', null) == null || (d.simge is string && d.simge.size() <= 16))
          && (d.get('silindi', null) == null || d.silindi is bool)
          && d.ad is string && d.ad.size() > 0 && d.ad.size() <= 60
          && d.sahip is string
          && d.uyeler is list && d.uyeler.size() >= 1 && d.uyeler.size() <= 20
          && d.sahip in d.uyeler;
      }

      allow create: if activeUser() && validCat(request.resource.data)
        && request.resource.data.sahip == me()
        && request.resource.data.olusturma == request.time
        && request.resource.data.uyeler.size() == 1;   // sahibi kurar; diğerleri sonra eklenir

      allow get: if activeUser() && isMember();
      allow list: if activeUser() && isMember();   // yalnızca "uyeler array-contains <ben>" sorgusu geçer

      allow update: if activeUser() && isMember() && validCat(request.resource.data)
        && request.resource.data.sahip == resource.data.sahip
        && request.resource.data.olusturma == resource.data.olusturma
        && (
          isOwner()                                   // sahip: ad ve üyeleri değiştirir
          || (                                         // üye: yalnızca kendini çıkarabilir
            request.resource.data.ad == resource.data.ad
            && request.resource.data.get('simge', null) == resource.data.get('simge', null)
            && request.resource.data.get('silindi', null) == resource.data.get('silindi', null)
            && request.resource.data.uyeler.size() == resource.data.uyeler.size() - 1
            && !(me() in request.resource.data.uyeler)
            && request.resource.data.uyeler.hasAll(resource.data.uyeler.removeAll([me()]))
          )
        );

      allow delete: if activeUser() && isOwner();

      match /tasks/{tid} {
        function cat() { return get(/databases/$(database)/documents/categories/$(cid)).data; }
        function member() { return activeUser() && me() in cat().uyeler; }
        function validTask(d) {
          // atananlar (liste), ust (alt görevin üst görev kimliği), saat, hatirlat, oncelik: sonradan eklenen alanlar; eski belgelerde yoktur (get ile okunur)
          return d.keys().hasOnly(['metin', 'bitti', 'son', 'tekrar', 'olusturan', 'atanan', 'olusturma',
                                    'bitirmeZamani', 'bitiren', 'silindi', 'silenKisi', 'guncelleme',
                                    'atananlar', 'ust', 'saat', 'hatirlat', 'oncelik', 'sira', 'eklendi'])
            && d.metin is string && d.metin.size() > 0 && d.metin.size() <= 500
            && d.bitti is bool && d.silindi is bool
            && (d.son == null || (d.son is string && d.son.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
            && (d.tekrar == null || (d.tekrar is string && d.tekrar.size() <= 40))
            && (d.atanan == null || d.atanan in cat().uyeler)
            && (d.get('atananlar', null) == null || (d.atananlar is list && d.atananlar.size() <= 20 && d.atananlar.hasOnly(cat().uyeler)))
            && (d.get('ust', null) == null || (d.ust is string && d.ust.size() <= 40))
            && (d.get('saat', null) == null || (d.saat is string && d.saat.matches('^[0-9]{2}:[0-9]{2}$')))
            && (d.get('hatirlat', null) == null || (d.hatirlat is list && d.hatirlat.size() <= 10))
            && (d.get('oncelik', null) == null || (d.oncelik is int && d.oncelik >= 0 && d.oncelik <= 3))
            && (d.get('sira', null) == null || d.sira is number)
            && (d.get('eklendi', null) == null || (d.eklendi is string && d.eklendi.size() <= 20))
            && (d.bitiren == null || d.bitiren in cat().uyeler)
            && (d.bitti == true || d.bitiren == null)
            && d.guncelleme == request.time;
        }

        allow get, list: if member();

        allow create: if member() && validTask(request.resource.data)
          && request.resource.data.olusturan == me()
          && request.resource.data.olusturma == request.time;

        allow update: if member() && validTask(request.resource.data)
          && request.resource.data.olusturan == resource.data.olusturan
          && request.resource.data.olusturma == resource.data.olusturma;

        // Fiziksel silme yalnızca kategori silinirken sahibin temizliği içindir; üyeler görevi yumuşak siler (silindi: true).
        allow delete: if activeUser() && cat().sahip == me();
      }
    }
  }
}
